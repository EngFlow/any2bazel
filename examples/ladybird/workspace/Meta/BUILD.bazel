package(default_visibility = ["//visibility:public"])

# All Python generator scripts + their shared helper packages (Meta/Utils,
# Meta/Generators/libweb_bindings). Generators do
# sys.path.append(<Meta dir>) then import Utils.* / Generators.*, so the whole
# tree must be present as tool inputs.
filegroup(
    name = "generators",
    srcs = glob([
        "Generators/**/*.py",
        "Utils/**/*.py",
    ]),
)

# The vcpkg_tree action's driver (see //:vcpkg.bzl). It resolves every download
# by SHA512 out of a Bazel-written index and runs vcpkg with x-block-origin, so
# the dependency build reaches the network zero times.
sh_binary(
    name = "vcpkg_build",
    srcs = ["vcpkg_build.sh"],
)
