load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
package(default_visibility = ["//visibility:public"])

# All Python generator scripts + their shared helper packages (Meta/Utils,
# Meta/Generators/libweb_bindings). Generators do
# sys.path.append(<Meta dir>) then import Utils.* / Generators.*, so the whole
# tree must be present as tool inputs.
filegroup(
    name = "generators",
    srcs = glob([
        "Generators/**/*.py",
        "Utils/**/*.py",
    ]),
)

# Ring 2: the driver for the vcpkg build action (see //:vcpkg.bzl). It runs
# `vcpkg install` with x-block-origin, resolving every download by SHA512 from
# files Bazel fetched, so the build reaches the network zero times.
sh_binary(
    name = "vcpkg_build",
    srcs = ["vcpkg_build.sh"],
)
