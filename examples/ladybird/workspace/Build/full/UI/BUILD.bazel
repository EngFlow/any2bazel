load("@rules_cc//cc:defs.bzl", "cc_library")
package(default_visibility = ["//visibility:public"])

# Qt moc/qrc are now generated by Bazel via rules_qt (see //:moc_* genrules in
# the root BUILD), so nothing from CMake's ladybird_autogen/ is consumed here
# any more. What remains is the glslang-generated shader headers, which are the
# next codegen step to Bazel-ify.
cc_library(
    name = "qt_autogen_headers",
    hdrs = glob(["Qt/*.h"], allow_empty = True),  # WebContentViewLinux{Frag,Vert}Shader.h
    includes = ["Qt"],  # included by bare name (<WebContentViewLinuxFragShader.h>)
)
