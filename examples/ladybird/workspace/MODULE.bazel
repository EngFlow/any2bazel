module(name = "ladybird", version = "0.0.0")

bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "platforms", version = "1.0.0")

# Bazel 9 removed the native sh_binary; //Meta:vcpkg_build is one.
bazel_dep(name = "rules_shell", version = "0.6.1")

# Qt6 via rules_qt (kklochkov). Its qt.local_repo discovers the host Qt through
# qmake, so moc/rcc and the Qt cc_library targets all come from one 6.10.2 SDK
# -- the version Ladybird's CMake asks for -- and the moc rule reads its include
# dirs from the Qt CcInfo compilation context instead of hand-passed -I flags.
# rules_qt 2.0.1 is NOT on the BCR (the BCR's "rules_qt" is Vertexwahn's
# unrelated rules_qt6), so point the dep at the upstream release tarball. This is
# stock upstream v2.0.1 -- no local patches -- so any checkout can fetch it.
bazel_dep(name = "rules_qt", version = "2.0.1")
archive_override(
    module_name = "rules_qt",
    urls = ["https://github.com/kklochkov/rules_qt/archive/refs/tags/v2.0.1.tar.gz"],
    strip_prefix = "rules_qt-2.0.1",
    integrity = "sha256-RLp8ZJu4VVgNqssn5q5WnsE1BH4yn6CvIHAAOWqnvpM=",
)

qt = use_extension("@rules_qt//qt:extensions.bzl", "qt")
qt.local_repo(
    name = "qt6_local",
    paths = {"linux-x86_64": "/usr/lib/qt6"},
)
qt.active_sdk(name = "qt", repo = "qt6_local")
use_repo(qt, "qt")
register_toolchains("@qt//:qt_linux_x86_64_toolchain")

# ---------------------------------------------------------------------------
# Ring 2: the vcpkg dependency tree. Bazel owns FETCHING (here); vcpkg is still
# the recipe that builds them (//:vcpkg_installed, see vcpkg.bzl).
#
# The 76 distfiles, their URLs and their SHA512s are all GENERATED from a capture
# of what vcpkg actually downloads (Meta/vcpkg_assets.tsv), by
# Meta/emit_vcpkg_bazel.py -- including the use_repo list below, because bzlmod
# needs every extension-created repo named here and 76 hand-kept names would
# drift. Regenerate all four files with:
#
#   python3 Meta/emit_vcpkg_bazel.py --assets Meta/vcpkg_assets.tsv --distfiles > vcpkg_distfiles.bzl
#   python3 Meta/emit_vcpkg_bazel.py --assets Meta/vcpkg_assets.tsv --index     > vcpkg_index.bzl
#   python3 Meta/emit_vcpkg_bazel.py --assets Meta/vcpkg_assets.tsv --extension > vcpkg_extension.bzl
#   python3 Meta/emit_vcpkg_bazel.py --assets Meta/vcpkg_assets.tsv --use-repo   # paste below
#
# None of those need vcpkg, CMake or the network: the capture IS the pin.
vcpkg_deps = use_extension("//:vcpkg_extension.bzl", "vcpkg_deps")
