module(name = "ladybird", version = "0.0.0")

bazel_dep(name = "rules_cc", version = "0.2.19")
bazel_dep(name = "platforms", version = "1.0.0")

# Bazel 9 removed the native sh_binary; //Meta:vcpkg_build is one.
bazel_dep(name = "rules_shell", version = "0.6.1")

# Qt6 via rules_qt (kklochkov). Its qt.local_repo discovers the host Qt through
# qmake, so moc/rcc and the Qt cc_library targets all come from one 6.10.2 SDK
# -- the version Ladybird's CMake asks for -- and the moc rule reads its include
# dirs from the Qt CcInfo compilation context instead of hand-passed -I flags.
# rules_qt 2.0.1 is NOT on the BCR (the BCR's "rules_qt" is Vertexwahn's
# unrelated rules_qt6), so point the dep at the upstream release tarball. This is
# stock upstream v2.0.1 -- no local patches -- so any checkout can fetch it.
bazel_dep(name = "rules_qt", version = "2.0.1")
archive_override(
    module_name = "rules_qt",
    urls = ["https://github.com/kklochkov/rules_qt/archive/refs/tags/v2.0.1.tar.gz"],
    strip_prefix = "rules_qt-2.0.1",
    integrity = "sha256-RLp8ZJu4VVgNqssn5q5WnsE1BH4yn6CvIHAAOWqnvpM=",
)

qt = use_extension("@rules_qt//qt:extensions.bzl", "qt")
qt.local_repo(
    name = "qt6_local",
    paths = {"linux-x86_64": "/usr/lib/qt6"},
)
qt.active_sdk(name = "qt", repo = "qt6_local")
use_repo(qt, "qt")
register_toolchains("@qt//:qt_linux_x86_64_toolchain")

# Qt's RUNTIME half. rules_qt wires up linking; nothing wired up the plugins Qt
# dlopens at QApplication construction, so the binary linked @qt's libQt6Core and
# then loaded the HOST's platform plugin into it -- two Qt builds in one process.
# On a box where SDK and distro versions differ that is a SIGSEGV in
# QXcbConnection::initializeScreens (reported on Ubuntu 24.04); where they agree it
# works by accident. @qt_plugins takes the plugins from the same SDK @qt names, and
# //:qt_conf points the binary at them. See qt_runtime.bzl for the whole story.
qt_runtime = use_extension("//:qt_runtime.bzl", "qt_runtime")
use_repo(qt_runtime, "qt_plugins")

# ---------------------------------------------------------------------------
# Chromium's HSTS preload table: the one input CMake downloads UNPINNED (from
# `main`, at configure time) and the one thing that made a Bazel-only clone
# non-hermetic. Pinned downstream to a commit + sha256 in hsts_preload.bzl --
# which also records why the commit is that one and not a release tag -- and
# regenerated by Meta/pin_hsts_preload.py. Consumed by :gen_HSTSPreloadData in
# codegen_root.bzl as @hsts_preload_json//file.
hsts = use_extension("//:hsts_preload.bzl", "hsts_preload")
use_repo(hsts, "hsts_preload_json")

