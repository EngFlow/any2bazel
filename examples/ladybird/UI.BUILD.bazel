load("@rules_cc//cc:defs.bzl", "cc_library")
package(default_visibility = ["//visibility:public"])

# Qt moc/qrc/uic autogen sources materialized by the reference build
# (Bazel-ifying moc is a Qt-specific Ring 2 task; consumed here as generated
# srcs, same shape as the vcpkg/rust prebuilt shims). mocs_compilation.cpp is a
# unity file #include-ing every EWIEGA46WW/moc_*.cpp, so those must be present.
exports_files(glob(["Qt/ladybird_autogen/**/*.cpp"], allow_empty = True))

# The autogen include tree (moc_predefs.h, ui_*.h) as a header root.
cc_library(
    name = "qt_autogen_headers",
    hdrs = glob([
        "Qt/ladybird_autogen/**/*.h",
        "Qt/*.h",  # generated shader headers (WebContentViewLinux{Frag,Vert}Shader.h)
    ], allow_empty = True),
    # ladybird_autogen/include for moc headers; Qt for the shader headers,
    # which are included by bare name (<WebContentViewLinuxFragShader.h>).
    includes = ["Qt/ladybird_autogen/include", "Qt"],
)

# The moc_*.cpp files are #include-d by mocs_compilation.cpp (Qt unity build),
# not compiled on their own; expose them as a filegroup to stage in the sandbox
# as additional_compiler_inputs of the ladybird binary.
filegroup(
    name = "qt_moc_included_srcs",
    srcs = glob(["Qt/ladybird_autogen/EWIEGA46WW/moc_*.cpp"], allow_empty = True),
)
