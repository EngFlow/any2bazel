# Python bytecode
__pycache__/
*.py[cod]

# Bazel stuff
/bazel-*

# Local symlink to a target repo used for a migration dry-run (Dolphin)
dolphin_migration

# Migration artifacts produced by the tool (live beside the target repo)
model.*.json
aquery.json
diff.json
actions.ndjson

# Don't track module lockfiles for examples.
/examples/**/MODULE.bazel.lock
